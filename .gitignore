# --- runtime artefacts (regenerated by the engine) ---------------------------
runs/traces/
runs/telemetry.sqlite
runs/logs/
runs/serve.log
runs/pytest-tmp/
runs/tmp/
runs/bench/hardening/20*.json
runs/llm_cache/
runs/bench/benchmark/traces/
runs/bench/benchmark/20*.json
runs/bench/semantic/20*.json
runs/bench/controller/20*/
runs/bench/controller_v2_2/20*/
runs/bench/controller_v2_2/modeling/
# Keep the frozen V2.2 publication bundle (including its 12 plots); ignore rerun churn.
!runs/bench/controller_v2_2/20261019T012057Z/
!runs/bench/controller_v2_2/20261019T012057Z/**
runs/bench/controller_v2_3/20*/
runs/bench/controller_v2_3/modeling/
# Keep the frozen V2.3 IC-COS selection/final-evaluation bundle; ignore rerun churn.
!runs/bench/controller_v2_3/20261019T051008Z/
!runs/bench/controller_v2_3/20261019T051008Z/**
*.log
!runs/baselines/**/*.log
*.pid
# Canonical measured summaries (runs/bench/*/latest.json, audit_sheet.csv) are kept as evidence.
# Timestamped reruns are local churn; the report's run_id remains inside latest.json.

